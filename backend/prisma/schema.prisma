generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  role         String   @default("CLIENTE") // CLIENTE, TECNICO, EMPRESA, ADMIN
  avatarUrl    String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  techProfile       TechProfile?
  companyOwned      Company?          @relation("CompanyOwner")
  companyEmployment CompanyEmployee?
  requestsCreated   ServiceRequest[]  @relation("ClientRequests")
  requestsAssigned  ServiceRequest[]  @relation("TechnicianRequests")
  reviewsWritten    Review[]          @relation("ReviewAuthor")
  reviewsReceived   Review[]          @relation("ReviewSubject")
  notifications     Notification[]
}

model TechProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id])
  specialty          String   @default("MANTENIMIENTO_GENERAL") // ELECTRICIDAD, PLOMERIA, AIRE_ACONDICIONADO, MANTENIMIENTO_GENERAL
  bio                String?
  verificationStatus String   @default("PENDIENTE") // PENDIENTE, VERIFICADO, RECHAZADO
  cedulaDocUrl       String?
  policeRecordUrl    String?
  avgRating          Float    @default(0)
  totalJobs          Int      @default(0)
  totalEarnings      Float    @default(0)
}

model Company {
  id                 Int      @id @default(autoincrement())
  name               String
  ownerId            Int      @unique
  owner              User     @relation("CompanyOwner", fields: [ownerId], references: [id])
  ruc                String?
  verificationStatus String   @default("PENDIENTE")
  address            String?
  
  employees          CompanyEmployee[]
  requests           ServiceRequest[]
}

model CompanyEmployee {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id])
  userId    Int     @unique
  user      User    @relation(fields: [userId], references: [id])
  role      String?
}

model ServiceCategory {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  icon        String
  
  requests    ServiceRequest[]
}

model ServiceRequest {
  id            Int      @id @default(autoincrement())
  clientId      Int
  client        User     @relation("ClientRequests", fields: [clientId], references: [id])
  categoryId    Int
  category      ServiceCategory @relation(fields: [categoryId], references: [id])
  companyId     Int?
  company       Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  technicianId  Int?
  technician    User?    @relation("TechnicianRequests", fields: [technicianId], references: [id])
  
  title         String
  description   String
  address       String
  neighborhood  String?
  urgency       String   @default("MEDIA") // BAJA, MEDIA, ALTA
  status        String   @default("SOLICITADO") // SOLICITADO, ASIGNADO, EN_PROGRESO, FINALIZADO, CANCELADO
  estimatedCost Float?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  appointment   Appointment?
  review        Review?

  @@index([companyId, status])
  @@index([clientId, status])
  @@index([technicianId, status])
}

model Appointment {
  id            Int      @id @default(autoincrement())
  requestId     Int      @unique
  request       ServiceRequest @relation(fields: [requestId], references: [id])
  scheduledDate DateTime
  notes         String?
}

model Review {
  id            Int      @id @default(autoincrement())
  requestId     Int      @unique
  request       ServiceRequest @relation(fields: [requestId], references: [id])
  clientId      Int
  client        User     @relation("ReviewAuthor", fields: [clientId], references: [id])
  technicianId  Int
  technician    User     @relation("ReviewSubject", fields: [technicianId], references: [id])
  
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO") // INFO, ALERTA, URGENTE
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
